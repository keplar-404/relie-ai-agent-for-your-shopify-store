{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillInputPayload",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "description": "Unique identifier for the task"
    },
    "action": {
      "type": "string",
      "enum": ["analyze", "validate", "generate", "execute"]
    },
    "payload": {
      "type": "object",
      "description": "The data content to process"
    }
  },
  "required": ["taskId", "action", "payload"]
}
